-- Mirrors .carta/03-system/01-store-model.schema.sql (table: location). Source of truth is the carta sidecar; keep in sync.

CREATE TABLE location (
    id              TEXT PRIMARY KEY,
    source_type     TEXT NOT NULL,
    source_id       TEXT NOT NULL,
    lat             REAL NOT NULL,
    lng             REAL NOT NULL,
    display_name    TEXT NOT NULL,
    cached_metadata TEXT,
    refreshable     INTEGER NOT NULL DEFAULT 0,
    UNIQUE (source_type, source_id)
);

selectAll:
SELECT * FROM location;
