    {
      "id": "screen.AddLocationToCollection",
      "kind": "rtp.screen",
      "props": {
        "name": "AddLocationToCollection",
        "surface": "AddLocationToCollection",
        "description": "Location-first flow: a Location is already chosen (dropped pin, shared link, etc.). User picks which Collection to add it to.",
        "reads": [
          "collections",
          "candidate-location"
        ]
      },
      "tags": [
        "picker"
      ]
    },
    {
      "id": "screen.CollectionDetail",
      "kind": "rtp.screen",
      "props": {
        "name": "CollectionDetail",
        "surface": "CollectionDetail",
        "description": "One Collection: its entries shown as either a map or a list projection (toggleable in place — projection is a view-internal mode, not a separate view). Entry point for adding/removing entries, editing the template, and exporting/sharing.",
        "reads": [
          "collection",
          "entries",
          "appearance"
        ]
      },
      "tags": [
        "detail"
      ]
    },
    {
      "id": "screen.CollectionEntryDetail",
      "kind": "rtp.screen",
      "props": {
        "name": "CollectionEntryDetail",
        "surface": "CollectionEntryDetail",
        "description": "One entry — the (Location, Review) pair. Read-mostly view; mutation goes through ReviewForm. Hosts the 'open externally' handoff to Google Maps / Apple Maps / etc.",
        "reads": [
          "entry",
          "location",
          "review"
        ]
      },
      "tags": [
        "detail"
      ]
    },
    {
      "id": "screen.CollectionList",
      "kind": "rtp.screen",
      "props": {
        "name": "CollectionList",
        "surface": "CollectionList",
        "description": "Manage the user's Collections. Create new ones, open existing ones, import external lists.",
        "reads": [
          "collections"
        ]
      },
      "tags": [
        "list"
      ]
    },
    {
      "id": "screen.ImportFlow",
      "kind": "rtp.screen",
      "props": {
        "name": "ImportFlow",
        "surface": "ImportFlow",
        "description": "Import an external collection. Stub — concrete steps (source picker, schema mapping, preview, confirm) will be detailed when the import view is unfolded.",
        "reads": []
      },
      "tags": [
        "modal"
      ]
    },
    {
      "id": "screen.LocationPicker",
      "kind": "rtp.screen",
      "props": {
        "name": "LocationPicker",
        "surface": "LocationPicker",
        "description": "Resolve, drop, or import a Location. Search via a configured provider, drop a manual pin, or import from a URL / file (KML, share link).",
        "reads": [
          "provider-results"
        ]
      },
      "tags": [
        "picker"
      ]
    },
    {
      "id": "screen.MapOverview",
      "kind": "rtp.screen",
      "props": {
        "name": "MapOverview",
        "surface": "MapOverview",
        "description": "The everything view. Default landing surface. Shows pins for every entry in every visible Collection, colored by Collection appearance and styled by visited/unvisited state. See doc01.03 §4.",
        "reads": [
          "all-collections",
          "all-entries",
          "viewport"
        ]
      },
      "tags": [
        "landing",
        "map"
      ]
    },
    {
      "id": "screen.ReviewForm",
      "kind": "rtp.screen",
      "props": {
        "name": "ReviewForm",
        "surface": "ReviewForm",
        "description": "Author or edit a Review instance against the Collection's template. Filling, clearing, and submitting fields are in-view concept actions (meta.actions); only SUBMIT and CANCEL move the user.",
        "reads": [
          "template",
          "draft-review"
        ]
      },
      "tags": [
        "form"
      ]
    },
    {
      "id": "screen.SchemaBuilder",
      "kind": "rtp.screen",
      "props": {
        "name": "SchemaBuilder",
        "surface": "SchemaBuilder",
        "description": "Author or edit a Collection's Review template — the schema governing every Review in this Collection. Add/remove/reorder fields; pick field types (stars, enum, boolean, date, power-ranking, text). Adopt a built-in template as a starting point.",
        "reads": [
          "template"
        ]
      },
      "tags": [
        "form"
      ]
    },
    {
      "id": "screen.Settings",
      "kind": "rtp.screen",
      "props": {
        "name": "Settings",
        "surface": "Settings",
        "description": "Configure providers, BYOK keys, sync target. View is intentionally under-specified until the relevant concept actions exist.",
        "reads": [
          "settings"
        ]
      },
      "tags": [
        "modal"
      ]
    }
  ],
