-- Mirrors .carta/03-system/01-store-model.schema.sql (table: collection). Source of truth is the carta sidecar; keep in sync.

CREATE TABLE collection (
    id                   TEXT PRIMARY KEY,
    name                 TEXT NOT NULL,
    description          TEXT,
    appearance_color     TEXT NOT NULL,
    appearance_pin_style TEXT NOT NULL,
    template_version     INTEGER NOT NULL DEFAULT 1,
    is_visible           INTEGER NOT NULL DEFAULT 1,
    power_ranking        INTEGER NOT NULL DEFAULT 0,
    created              TEXT NOT NULL,
    last_modified        TEXT NOT NULL
);

selectAll:
SELECT * FROM collection;

observeAll:
SELECT * FROM collection;

observeById:
SELECT * FROM collection WHERE id = ?;

insert:
INSERT INTO collection (id, name, description, appearance_color, appearance_pin_style, template_version, is_visible, power_ranking, created, last_modified)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

bumpLastModified:
UPDATE collection SET last_modified = ? WHERE id = ?;

updateMetadata:
UPDATE collection SET name = ?, description = ?, appearance_color = ?, appearance_pin_style = ?, power_ranking = ?, last_modified = ? WHERE id = ?;

bumpLastModifiedAndTemplateVersion:
UPDATE collection SET last_modified = ?, template_version = ? WHERE id = ?;
