{
  "surface": "CollectionList",
  "regions": [
    {
      "id": "topBar",
      "purpose": "Identifies the surface and holds the collection-level creation affordances."
    },
    {
      "id": "content",
      "purpose": "The user's Collections, browsable as a vertical list."
    }
  ],
  "affordances": [
    {
      "id": "back",
      "label": "Back",
      "region": "topBar",
      "event": "BACK",
      "target": "MapOverview"
    },
    {
      "id": "new-collection",
      "label": "New Collection",
      "region": "topBar",
      "event": "TAP_NEW_COLLECTION",
      "target": "SchemaBuilder",
      "action": "Collection.create"
    },
    {
      "id": "import-list",
      "label": "Import a list",
      "region": "topBar",
      "event": "TAP_IMPORT",
      "target": "ImportFlow",
      "action": "Collection.import"
    }
  ],
  "lists": [
    {
      "id": "collections",
      "region": "content",
      "iterates": "Collection",
      "reads": "collections",
      "item": {
        "shows": [
          "Collection.name",
          "Collection.appearance (color, pinStyle) as a visual marker",
          "entry count for the Collection"
        ],
        "affordance": {
          "id": "open-collection",
          "label": "Open a Collection",
          "event": "TAP_COLLECTION",
          "target": "CollectionDetail"
        }
      },
      "emptyState": "When the user has no Collections, the region shows a hint pointing at New Collection and Import a list."
    }
  ]
}
