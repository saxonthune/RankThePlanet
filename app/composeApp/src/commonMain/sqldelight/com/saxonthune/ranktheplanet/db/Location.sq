-- Mirrors .rhidoc/03-system/01-store-model.schema.sql (table: location). Source of truth is the rhidoc sidecar; keep in sync.

CREATE TABLE location (
    id              TEXT PRIMARY KEY,
    source_type     TEXT NOT NULL,
    source_id       TEXT NOT NULL,
    lat             REAL NOT NULL,
    lng             REAL NOT NULL,
    display_name    TEXT NOT NULL,
    address         TEXT,
    cached_metadata TEXT,
    refreshable     INTEGER NOT NULL DEFAULT 0,
    UNIQUE (source_type, source_id)
);

selectAll:
SELECT * FROM location;

findByIdentity:
SELECT * FROM location WHERE source_type = ? AND source_id = ?;

selectById:
SELECT * FROM location WHERE id = ?;

insert:
INSERT INTO location (id, source_type, source_id, lat, lng, display_name, address, cached_metadata, refreshable)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE location SET source_type = ?, source_id = ?, lat = ?, lng = ?, display_name = ?, address = ?, cached_metadata = ?, refreshable = ? WHERE id = ?;

delete:
DELETE FROM location WHERE id = ?;

deleteOrphans:
DELETE FROM location WHERE id NOT IN (SELECT DISTINCT location_id FROM entry);
