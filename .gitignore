# Compiled class file
*.class


# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

.idea/

.todo-tasks/

# Node tooling
node_modules/
package-lock.json

.DS_Store
.temp/

# Claude compatibility is committed; only machine-local permissions/settings stay local.
.claude/settings.local.json

__pycache__/

# Derived Luminous canvas output (generated by .luminous/statechart-canvas.pipeline.mjs)
.luminous/generated/

# Local-only build credentials (signing team, device id)
credentials.mk

# Xcode project (project.pbxproj carries local signing team/device id;
# xcuserdata/xcuserstate are per-developer machine state)
app/iosApp/iosApp.xcodeproj/
*.xcuserstate
xcuserdata/

# Generated by aboutlibraries Gradle plugin (committed as a build artifact, not source)
app/composeApp/src/commonMain/composeResources/files/aboutlibraries.json
